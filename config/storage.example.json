{
  "schema_version": "2026-09-23.phase01",
  "private_root": "private",
  "paths": {
    "database": "private/db/space.sqlite3",
    "artifacts": "private/artifacts",
    "sessions": "private/sessions",
    "screenshots": "private/screenshots"
  },
  "secret_store": {
    "configured": false,
    "reference": "OS secret store or approved secret manager in a later phase"
  },
  "backup": {
    "configured": false,
    "boundary": "Private root only; no credentials in repository backups."
  },
  "git_exclusions": [
    "private/",
    "*.sqlite",
    "*.db",
    "*.pdf",
    "*.docx",
    "*.tex",
    "screenshots/",
    "sessions/"
  ]
}

