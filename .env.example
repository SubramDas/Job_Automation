# Synthetic/local-only defaults. Do not put real secrets or personal data here.
JOB_AUTOMATION_ENV=local
JOB_AUTOMATION_CONFIG_DIR=config
JOB_AUTOMATION_PRIVATE_DIR=private
JOB_AUTOMATION_DRY_RUN=true

# Provider keys remain unset until a later provider/privacy decision.
OPENAI_API_KEY=

# Optional Phase 05E job-search API candidates. Keep real values out of Git.
# Jobicy public API needs no key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_USER_AGENT_EMAIL=
USAJOBS_AUTHORIZATION_KEY=
JOBSPIPE_API_KEY=
JOBSPY_MCP_URL=http://127.0.0.1:9423/api
